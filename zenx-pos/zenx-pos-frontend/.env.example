# Server-side API target for contact/quote submissions and business-type options.
# Local default: http://127.0.0.1:5100/api. Set this for the deployed backend
# before building the website, e.g. https://retail-api.zenxpos.com/api.
ZENXPOS_API_BASE_URL=http://127.0.0.1:5100/api

# Optional direct browser API target; leave empty to use the same-origin proxy.
# When set, the backend CORS_ALLOWED_ORIGINS must include the website origin.
NEXT_PUBLIC_API_BASE_URL=
