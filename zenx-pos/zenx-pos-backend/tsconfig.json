{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmitOnError": true,
    "esModuleInterop": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "rootDir": ".",
    "outDir": "dist",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["index.ts", "models/**/*.ts", "middlewares/**/*.ts", "routes/**/*.ts"]
}
