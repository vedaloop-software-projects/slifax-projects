NODE_ENV=development
HOST=127.0.0.1
PORT=5100
PUBLIC_BASE_URL=http://127.0.0.1:5100

# Generate a unique secret of at least 32 bytes. Never commit the real value.
JWT_SECRET=
JWT_ISSUER=zenx-pos-api
JWT_AUDIENCE=zenx-pos-client
JWT_LIFETIME=8h
AUDIT_PAGE_SIZE=25
UPLOAD_ROOT=public

# Password-reset OTP delivery webhook. It receives destination, code, purpose, and expiresInMinutes.
# Remote URLs must use HTTPS. Keep the provider token out of source control.
RESET_HMAC_SECRET=
OTP_DELIVERY_URL=
OTP_DELIVERY_TOKEN=
OTP_LIFETIME_MINUTES=10
RESET_TOKEN_LIFETIME_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Leave blank until your TiDB database is ready. URL-encode special characters in credentials.
# DATABASE_URL="mysql://USER:PASSWORD@HOST:4000/zenxpos_dev?sslaccept=strict"
DATABASE_URL=
DB_SSL=true
# TiDB Starter normally uses trusted public certificates; no CA file is needed.
DB_SSL_CA=
DB_POOL_SIZE=5
DB_TIMEZONE=+05:30
DB_TRANSACTION_WAIT_MS=5000
DB_TRANSACTION_TIMEOUT_MS=10000

# Optional Redis. Remote connections must use rediss://. When absent, OTP challenges
# use the database cache table and profile/product caching is disabled.
REDIS_URL=
REDIS_KEY_PREFIX=zenxpos:v1:
PROFILE_CACHE_TTL_SECONDS=300
PRODUCT_CACHE_TTL_SECONDS=120

# Integration target: must be a separate database whose name ends in _test.
DATABASE_TEST_URL=
