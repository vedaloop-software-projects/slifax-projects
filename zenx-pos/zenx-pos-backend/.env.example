NODE_ENV=development
HOST=127.0.0.1
PORT=5100
PUBLIC_BASE_URL=http://127.0.0.1:5100
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://barcode.zenxpos.com

# Generate a unique secret of at least 32 bytes. Never commit the real value.
JWT_SECRET=
JWT_ISSUER=zenx-pos-api
JWT_AUDIENCE=zenx-pos-client
JWT_LIFETIME=8h
AUDIT_PAGE_SIZE=25
MASTER_PAGE_SIZE=25
EXPENSE_PAGE_SIZE=25
EXPENSE_EXPORT_LIMIT=10000
USER_PAGE_SIZE=25
WORKFORCE_PAGE_SIZE=25
PRODUCT_SEARCH_LIMIT=100
CUSTOMER_PAGE_SIZE=25
PRODUCT_PAGE_SIZE=25
PRODUCT_SCAN_LIMIT=10000
PRODUCT_IMPORT_ROW_LIMIT=5000
PRODUCT_CACHE_TTL_SECONDS=60
SETTINGS_PAGE_SIZE=25
COUPON_PAGE_SIZE=25
KIT_PRODUCT_LIMIT=500
STOCK_ADJUSTMENT_LIST_LIMIT=500
TRANSFER_LIST_LIMIT=500
HAPPY_HOUR_PAGE_SIZE=25
DISCOUNT_PAGE_SIZE=25
SALON_RESULT_LIMIT=500
UPLOAD_ROOT=public

# Password-reset OTP delivery webhook. It receives destination, code, purpose, and expiresInMinutes.
# Remote URLs must use HTTPS. Keep the provider token out of source control.
RESET_HMAC_SECRET=
OTP_DELIVERY_URL=
OTP_DELIVERY_TOKEN=
OTP_LIFETIME_MINUTES=10
RESET_TOKEN_LIFETIME_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# URL-encode special characters in database credentials.
# Docker Compose example: mysql://zenxpos_app:PASSWORD@mysql:3306/zenxpos_staging
DATABASE_URL=
DB_SSL=false
# Permit plaintext only for a loopback, RFC1918, or Docker-internal database host.
DB_ALLOW_PLAINTEXT_PRIVATE=true
DB_SSL_CA=
DB_POOL_SIZE=5
DB_TIMEZONE=+05:30
DB_TRANSACTION_WAIT_MS=5000
DB_TRANSACTION_TIMEOUT_MS=30000
LOG_LEVEL=info
SUPPORT_SMTP_HOST=smtp.gmail.com
SUPPORT_SMTP_PORT=465
SUPPORT_SMTP_SECURE=true
SUPPORT_SMTP_USER=
SUPPORT_SMTP_APP_PASSWORD=
SUPPORT_EMAIL_FROM=
SUPPORT_EMAIL_TO=

# Optional Redis. Use either a TLS Redis URL or both Upstash REST values. When absent,
# OTP challenges use the database cache table and profile/product caching is disabled.
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_KEY_PREFIX=zenxpos:v1:
PROFILE_CACHE_TTL_SECONDS=300
PRODUCT_CACHE_TTL_SECONDS=120

# Integration target: must be a separate database whose name ends in _test.
DATABASE_TEST_URL=
ADMIN_PATH=/admin
ADMIN_PAGE_SIZE=25
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes
# A single 32-byte base64 key used only to encrypt tenant-specific integration
# credentials stored in MySQL. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_CREDENTIALS_MASTER_KEY=
# ZenxPOS merchant credentials used only for tenant subscription renewals.
# Every tenant pays the same ZenxPOS Cashfree account; never store these values
# in a tenant integration record or expose them to the POS application.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_RETURN_URL=https://staging-retail-api.zenxpos.com/api/subscription/cashfree/return?order_id={order_id}
# `npx prisma db seed` generates initial login credentials, stores their hashes in
# MySQL, and prints the credentials once. No seeded login or role comes from env.
KOT_RESULT_LIMIT=500
# Reporting pagination and maximum rows scanned for an individual report request.
REPORT_PAGE_SIZE=25
REPORT_SCAN_LIMIT=50000
