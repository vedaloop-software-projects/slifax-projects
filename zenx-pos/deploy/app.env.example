# Copy to /opt/zenxpos/staging/app.env on the VPS and set mode 600.
# Production uses a different file at /opt/zenxpos/production/app.env.
PUBLIC_BASE_URL=https://staging.example.com
CORS_ALLOWED_ORIGINS=https://barcode.zenxpos.com
JWT_SECRET=
JWT_ISSUER=zenx-pos-api
JWT_AUDIENCE=zenx-pos-client
JWT_LIFETIME=8h
ADMIN_PATH=/admin
ADMIN_PAGE_SIZE=25
ADMIN_SESSION_SECRET=

# Docker staging example: mysql://zenxpos_app:URL_ENCODED_PASSWORD@mysql:3306/zenxpos_staging
DATABASE_URL=
DB_SSL=false
DB_ALLOW_PLAINTEXT_PRIVATE=true
DB_SSL_CA=
DB_POOL_SIZE=5
DB_TIMEZONE=+05:30
DB_TRANSACTION_WAIT_MS=5000
DB_TRANSACTION_TIMEOUT_MS=30000

LOG_LEVEL=info

REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_KEY_PREFIX=zenxpos:staging:v1:
PROFILE_CACHE_TTL_SECONDS=300
PRODUCT_CACHE_TTL_SECONDS=120

RESET_HMAC_SECRET=
OTP_DELIVERY_URL=
OTP_DELIVERY_TOKEN=
OTP_LIFETIME_MINUTES=10
RESET_TOKEN_LIFETIME_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

AUDIT_PAGE_SIZE=25
MASTER_PAGE_SIZE=25
EXPENSE_PAGE_SIZE=25
EXPENSE_EXPORT_LIMIT=10000
USER_PAGE_SIZE=25
WORKFORCE_PAGE_SIZE=25
PRODUCT_SEARCH_LIMIT=100
CUSTOMER_PAGE_SIZE=25
PRODUCT_PAGE_SIZE=25
PRODUCT_SCAN_LIMIT=10000
PRODUCT_IMPORT_ROW_LIMIT=5000
SETTINGS_PAGE_SIZE=25
COUPON_PAGE_SIZE=25
KIT_PRODUCT_LIMIT=500
STOCK_ADJUSTMENT_LIST_LIMIT=500
TRANSFER_LIST_LIMIT=500
HAPPY_HOUR_PAGE_SIZE=25
DISCOUNT_PAGE_SIZE=25
SALON_RESULT_LIMIT=500
KOT_RESULT_LIMIT=500
