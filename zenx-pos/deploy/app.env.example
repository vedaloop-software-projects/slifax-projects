# Copy to /opt/zenxpos/staging/app.env on the VPS and set mode 600.
# Production uses a different file at /opt/zenxpos/production/app.env.
PUBLIC_BASE_URL=https://staging.example.com
CORS_ALLOWED_ORIGINS=https://barcode.zenxpos.com
JWT_SECRET=
JWT_ISSUER=zenx-pos-api
JWT_AUDIENCE=zenx-pos-client
JWT_LIFETIME=8h
ADMIN_PATH=/admin
ADMIN_PAGE_SIZE=25
ADMIN_SESSION_SECRET=
# Base64-encoded 32-byte key that encrypts every tenant's gateway credentials.
# Keep this stable across deployments and store it only in the protected app.env.
INTEGRATION_CREDENTIALS_MASTER_KEY=

# Platform-owned Cashfree merchant account for ZenxPOS subscription renewals.
# These credentials are shared by the renewal flow for every tenant.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_RETURN_URL=https://staging-retail-api.zenxpos.com/api/subscription/cashfree/return?order_id={order_id}

# Docker staging example: mysql://zenxpos_app:URL_ENCODED_PASSWORD@mysql:3306/zenxpos_staging
DATABASE_URL=
DB_SSL=false
DB_ALLOW_PLAINTEXT_PRIVATE=true
DB_SSL_CA=
DB_POOL_SIZE=10
DB_TIMEZONE=+05:30
DB_TRANSACTION_WAIT_MS=5000
DB_TRANSACTION_TIMEOUT_MS=30000

LOG_LEVEL=info

# P1 incident email delivery. Use a Google account with 2-Step Verification and an App Password.
SUPPORT_SMTP_HOST=smtp.gmail.com
SUPPORT_SMTP_PORT=465
SUPPORT_SMTP_SECURE=true
SUPPORT_SMTP_USER=
SUPPORT_SMTP_APP_PASSWORD=
SUPPORT_EMAIL_FROM=
# Comma-separated support recipients.
SUPPORT_EMAIL_TO=

# New website enquiry alerts reuse SUPPORT_SMTP_* above.
# Optional comma-separated override; blank reuses SUPPORT_EMAIL_TO.
ENQUIRY_EMAIL_TO=
# Optional sender; blank reuses SUPPORT_EMAIL_FROM, then SUPPORT_SMTP_USER.
ENQUIRY_EMAIL_FROM=
# Optional superadmin app base URL; alert links append #/website-enquiries.
# Use HTTPS (HTTP is allowed only for local loopback); no URL credentials.
ENQUIRY_ADMIN_URL=

REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_KEY_PREFIX=zenxpos:staging:v1:
PROFILE_CACHE_TTL_SECONDS=300
PRODUCT_CACHE_TTL_SECONDS=120

RESET_HMAC_SECRET=
OTP_DELIVERY_URL=
OTP_DELIVERY_TOKEN=
OTP_LIFETIME_MINUTES=10
RESET_TOKEN_LIFETIME_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

AUDIT_PAGE_SIZE=25
MASTER_PAGE_SIZE=25
EXPENSE_PAGE_SIZE=25
EXPENSE_EXPORT_LIMIT=10000
USER_PAGE_SIZE=25
WORKFORCE_PAGE_SIZE=25
PRODUCT_SEARCH_LIMIT=100
CUSTOMER_PAGE_SIZE=25
PRODUCT_PAGE_SIZE=25
PRODUCT_SCAN_LIMIT=10000
PRODUCT_IMPORT_ROW_LIMIT=5000
SETTINGS_PAGE_SIZE=25
COUPON_PAGE_SIZE=25
KIT_PRODUCT_LIMIT=500
STOCK_ADJUSTMENT_LIST_LIMIT=500
TRANSFER_LIST_LIMIT=500
HAPPY_HOUR_PAGE_SIZE=25
DISCOUNT_PAGE_SIZE=25
SALON_RESULT_LIMIT=500
KOT_RESULT_LIMIT=500
